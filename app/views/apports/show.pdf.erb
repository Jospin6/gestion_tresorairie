<!DOCTYPE html>
<html>
<head>
    <title>Reçu <%= @recu.id %></title>
    <meta charset="UTF-8">
    <style>
        <%= File.read(Rails.root.join("app/assets/stylesheets/application.css")) %>
        body {
            font-family: Arial, sans-serif;
        }
        h1 {
            color: #333;
        }
    </style>
</head>
<body>
    <h1 class="text-2xl font-bold">Reçu Apport</h1>
    <p class="text-xl">N°: <%= @recu.id %>, Date <%= @recu.date_jour %></p>
    <p class="text-xl">Membre: <%= @recu.membre_conseil.nom %></p>
    <p>Montant: <%= number_to_currency(@recu.montant_recu) %></p>
</body>
</html>