<tr id="<%= dom_id autres_depense %>" class="border-b-[1px] border-gray-400 text-center text-[14px]">
  <td><%= autres_depense.titre %></td>
  <td><%= autres_depense.montant %> <%= autres_depense.devise %></td>
  <td><%= autres_depense.description %></td>
  <td><%= autres_depense.date_jour %></td>
  <td>
    <%= link_to 'print', recu_path(id: autres_depense.id, format: :pdf), class: 'text-blue-500 cursor-pointer' %>
  </td>
</tr>
